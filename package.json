{
  "name": "penpot-flutter-design-compiler",
  "version": "1.0.0",
  "description": "Production-grade Penpot plugin that compiles Penpot designs into structured, deterministic Flutter Design AST and specifications for AI coding agents.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:plugin",
    "build:plugin": "rollup -c rollup.plugin.config.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "penpot",
    "penpot-plugin",
    "flutter",
    "dart",
    "design-compiler",
    "ast",
    "code-generation"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@penpot/plugin-types": "^1.5.0",
    "jszip": "^3.10.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.13.0",
    "rollup": "^4.63.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
